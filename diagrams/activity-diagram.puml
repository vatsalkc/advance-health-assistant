@startuml Health Assistant Simple Activity Diagram
!theme plain
skinparam activity {
  BackgroundColor #E1F5FE
  BorderColor #0277BD
  StartColor #4CAF50
  EndColor #F44336
}

title Health Assistant System - Simple Activity Diagram

start

:Patient Login to System;

:Choose Action;

if (What to do?) then (Upload Report)
  :Select Report Files;
  :Fill Report Details;
  :Upload to System;
  :Report Saved;
elseif (Use AI Checker) then (yes)
  :Enter Symptoms;
  :AI Analyzes Symptoms;
  :Get Health Advice;
elseif (Book Appointment) then (yes)
  :Select Doctor;
  :Choose Date/Time;
  :Book Appointment;
endif

:Action Completed;

fork
  :Doctor Login to System;
  :View Patient List;
  :Select Patient;
  :Review Patient Reports;
  :Create Diagnosis;
  :Save Diagnosis;
fork again
  :Admin Login to System;
  :Manage Users;
  :View System Data;
end fork

stop

@enduml