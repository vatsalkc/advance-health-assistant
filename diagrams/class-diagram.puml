@startuml Health Assistant 7 Core Classes Diagram
!theme plain
skinparam class {
  BackgroundColor #E8F5E8
  BorderColor #4CAF50
  ArrowColor #2E7D32
}

title Health Assistant System - 7 Core Classes Diagram

class Patient {
  +id: string
  +name: string
  +email: string
  +phone: string
  +dateOfBirth: Date
  --
  +uploadReport(): boolean
  +viewReports(): Report[]
  +bookAppointment(): boolean
  +useSymptomChecker(): AnalysisResult
}

class Doctor {
  +id: string
  +name: string
  +specialization: string
  +licenseNumber: string
  --
  +viewPatients(): Patient[]
  +createDiagnosis(): boolean
  +reviewReports(): Report[]
  +manageAppointments(): boolean
}

class Admin {
  +id: string
  +name: string
  +email: string
  +role: string
  --
  +manageUsers(): boolean
  +viewAnalytics(): Analytics
  +configureSystem(): boolean
}

class MedicalReport {
  +id: string
  +title: string
  +type: string
  +content: string
  +attachments: string[]
  +reportDate: Date
  --
  +upload(): boolean
  +download(): File
  +delete(): boolean
}

class Diagnosis {
  +id: string
  +diagnosisText: string
  +symptoms: string[]
  +recommendations: string
  +severity: string
  --
  +create(): boolean
  +update(): boolean
  +view(): DiagnosisDetails
}

class Database {
  +connection: string
  +tables: string[]
  --
  +save(data): boolean
  +retrieve(id): Data
  +update(id, data): boolean
  +delete(id): boolean
}

class AISymptomChecker {
  +symptoms: string[]
  +mlModel: string
  +confidence: number
  --
  +analyzeSymptoms(): AnalysisResult
  +predictDisease(): Prediction
  +getRecommendations(): string[]
  +trainModel(): boolean
}

' Simple Relationships
Patient --> MedicalReport : uploads
Patient --> Diagnosis : receives
Patient --> AISymptomChecker : uses
Doctor --> Patient : treats
Doctor --> Diagnosis : creates
Doctor --> MedicalReport : reviews
Admin --> Patient : manages
Admin --> Doctor : manages
MedicalReport --> Database : stored in
Diagnosis --> Database : stored in
Patient --> Database : stored in
Doctor --> Database : stored in
AISymptomChecker --> Database : accesses

@enduml